# Optional: read LMTP-delivered mail from disk (no IMAP). NixOS production sets this for zacks-maids-node.
# INFO_MAILDIR=/var/vmail/zacks.cleaners.tesko.io/info/mail

# =============================================================================
# Copy this file to `.env` in the same directory (repo root) and edit values.
# Never commit `.env`. systemd `zacks-maids-node` loads `${projectRoot}/.env`.
#
# Local dev without Postfix: comment out SMTP_HOST (and related SMTP_*), set
# SENDGRID_API_KEY, or registration will fail when nothing listens on :25.
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE_URL  (required)
# PostgreSQL connection string used by the API and migrate script.
# zacks.cleaners.tesko.io uses its own database — NOT rei.tesko.io (5434/rei_maids).
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://zacks:zacks_dev@127.0.0.1:5433/zacks_maids

# -----------------------------------------------------------------------------
# SESSION_SECRET  (required in production)
# Generate once:  openssl rand -hex 32
# -----------------------------------------------------------------------------
SESSION_SECRET=REPLACE_WITH_OUTPUT_OF_openssl_rand_hex_32

# -----------------------------------------------------------------------------
# PUBLIC_ORIGIN  (required for correct email links)
# Public HTTPS URL of the site, no trailing slash.
# -----------------------------------------------------------------------------
PUBLIC_ORIGIN=https://zacks.cleaners.tesko.io
PUBLIC_SITE_ORIGIN=https://zacks.cleaners.tesko.io

# -----------------------------------------------------------------------------
# PORT  (optional) — zacks uses 3000; rei uses 3001 on the same host.
# -----------------------------------------------------------------------------
PORT=3000

# -----------------------------------------------------------------------------
# Outbound email  (required for registration + password reset)
# Production on NixOS with shared mail (maids-shared-mail.nix):
#   Use loopback SMTP; MAIL_FROM / MAIL_FROM_INFO use @zacks.cleaners.tesko.io.
# -----------------------------------------------------------------------------

MAIL_FROM="Zack's Maids <noreply@zacks.cleaners.tesko.io>"
MAIL_INFO_ADDRESS=info@zacks.cleaners.tesko.io
MAIL_FROM_INFO="Zack's Maids <info@zacks.cleaners.tesko.io>"

# Optional FQDN for SMTP EHLO (defaults to domain part of MAIL_FROM).
# SMTP_EHLO_HOSTNAME=zacks.cleaners.tesko.io

# --- Inbound info@ mail into Messages (migration 013) ---
# Prefer INFO_MAILDIR on the same host as Postfix/LMTP — no IMAP listener required.
# Nix mail stack sets this under systemd; duplicate here for non-Nix or tests.
INFO_MAILDIR=/var/vmail/zacks.cleaners.tesko.io/info/mail

# --- IMAP (optional fallback when maildir sync fails) ---
# When both sites share Dovecot, zacks uses :993 and rei uses :2993.
IMAP_HOST=127.0.0.1
IMAP_TLS_SERVERNAME=zacks.cleaners.tesko.io
IMAP_PORT=993
IMAP_TLS=1
IMAP_USER=info@zacks.cleaners.tesko.io
IMAP_PASS=replace_me

# --- Local Postfix on same host (typical NixOS production) ---
SMTP_HOST=127.0.0.1
SMTP_PORT=25
SMTP_SECURE=0

# --- Or Twilio Email (SendGrid): comment out SMTP_HOST block above and set key ---
# SENDGRID_API_KEY=SG.xxx_replace_me

# -----------------------------------------------------------------------------
# REGISTRATION_OTP_PEPPER  (optional)
# -----------------------------------------------------------------------------
# REGISTRATION_OTP_PEPPER=

# -----------------------------------------------------------------------------
# Administrator login (Overview / admin APIs)
# -----------------------------------------------------------------------------
# ADMIN_PASSWORD=
# ADMIN_USERNAME=
ADMIN_EMAIL=admin@zacks.cleaners.local

# -----------------------------------------------------------------------------
# Behind nginx / NixOS — production often sets these via systemd environment
# -----------------------------------------------------------------------------
# LISTEN_HOST=127.0.0.1
# SERVE_STATIC=false
# TRUST_PROXY=1
# NODE_ENV=production

# -----------------------------------------------------------------------------
# Twilio SMS  (optional)
# -----------------------------------------------------------------------------
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# -----------------------------------------------------------------------------
# Stripe Payments (bookings checkout)
# -----------------------------------------------------------------------------
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
